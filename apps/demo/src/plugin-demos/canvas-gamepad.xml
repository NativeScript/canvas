<Page xmlns="http://schemas.nativescript.org/tns.xsd" xmlns:canvas="@nativescript/canvas" navigatingTo="navigatingTo" class="page">
	<Page.actionBar>
		<ActionBar title="canvas-gamepad" icon="" class="action-bar">
		</ActionBar>
	</Page.actionBar>
	<GridLayout unloaded="{{ unloaded }}" iosOverflowSafeArea="false">
		<canvas:Canvas iosOverflowSafeArea="false" loaded="{{ canvasLoaded }}" style="width:100%;height:100%;" />
	</GridLayout>
</Page>
