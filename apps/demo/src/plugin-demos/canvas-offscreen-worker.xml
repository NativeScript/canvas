<Page xmlns="http://schemas.nativescript.org/tns.xsd" xmlns:canvas="@nativescript/canvas" navigatingTo="navigatingTo" class="page">
	<Page.actionBar>
		<ActionBar title="OffscreenCanvas in a Worker" icon="" class="action-bar" />
	</Page.actionBar>
	<GridLayout rows="*, *, auto" backgroundColor="#cfe0ff">
		<canvas:Canvas row="0" id="twoD" width="100%" height="100%" loaded="{{ canvasLoaded }}" />
		<canvas:Canvas row="1" id="webgl" width="100%" height="100%" loaded="{{ canvasLoaded }}" />
		<Label row="2" text="{{ status }}" textWrap="true" class="p-10" />
	</GridLayout>
</Page>
