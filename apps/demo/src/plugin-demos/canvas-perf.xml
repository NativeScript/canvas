<Page xmlns="http://schemas.nativescript.org/tns.xsd" xmlns:canvas="@nativescript/canvas" navigatingTo="navigatingTo" class="page">
	<Page.actionBar>
		<ActionBar title="canvas perf" icon="" class="action-bar" />
	</Page.actionBar>
	<GridLayout rows="*, auto" columns="*" style="width:100%;height:100%">
		<canvas:Canvas row="0" col="0" id="canvas" ready="{{ canvasReady }}" style="width:100%;height:100%;" />
		<Label row="1" col="0" text="{{ status }}" textWrap="true" class="p-10" />
	</GridLayout>
</Page>
