{
	"name": "@nativescript/canvas-napi",
	"private": true,
	"version": "0.1.0",
	"description": "Node-API build of the canvas native module (global.CanvasModule).",
	"napi": {
		"binaryName": "canvasnative",
		"targets": [
			"x86_64-pc-windows-msvc",
			"aarch64-pc-windows-msvc"
		]
	},
	"scripts": {
		"build": "napi build --platform --profile release-napi --no-js --dts-header \"\"",
		"build:debug": "napi build --platform --no-js",
		"test": "node --expose-gc --test \"__test__/*.test.mjs\"",
		"bench": "node --expose-gc bench/run.mjs"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.10.5"
	},
	"engines": {
		"node": ">=20"
	}
}
