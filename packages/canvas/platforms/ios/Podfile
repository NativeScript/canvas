platform :ios, '12.0'

# The NativeScript V8 headers package is provided via SPM (the `NativeScriptV8`
# product of the local Swift package shipped in this npm package) instead of a
# `pod 'NativeScript'`.
#
# The v8 include paths the canvas C++ needs (<NativeScript/include/v8.h> plus
# bare-name includes like "v8config.h") are delivered by build.xcconfig as
# OTHER_CFLAGS/OTHER_CPLUSPLUSFLAGS -I flags — see the comment there. They can
# NOT be delivered here: CocoaPods saves the user project during integration,
# BEFORE post_install runs, so build-setting edits made below never persist to
# disk. The hook is kept only as a best-effort for CocoaPods versions that do
# save afterwards; do not rely on it.
post_install do |installer|
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']

        config.build_settings['HEADER_SEARCH_PATHS'] << \
          '$(BUILD_DIR)/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)/NativeScript.framework/Headers'

        config.build_settings['HEADER_SEARCH_PATHS'] << \
          '$(BUILD_DIR)/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)/NativeScript.framework/Headers/include'
      end
    end
  end
end
