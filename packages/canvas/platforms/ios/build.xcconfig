OTHER_LDFLAGS[sdk=iphone*] = $(inherited) -framework Foundation -framework CanvasNative -framework OpenGLES -framework GLKit
OTHER_LDFLAGS[sdk=xros*] = $(inherited) -framework Foundation -framework CanvasNative -framework Metal
OTHER_LDFLAGS[sdk=xrsimulator*] = $(inherited) -framework Foundation -framework CanvasNative -framework Metal
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -framework Foundation -framework CanvasNative -framework Metal

// V8 14.9's headers use C++20 concepts/requires-clauses (e.g. v8-internal.h),
// so this can no longer be c++17.
CLANG_CXX_LANGUAGE_STANDARD = c++20

GLES_SILENCE_DEPRECATION = 1

// The canvas C++ sources include "include/v8.h", which the NativeScriptV8 SPM
// product (nativescript-v8/Package.swift, publicHeadersPath:"Headers") makes
// reachable by exposing nativescript-v8/Headers itself as a search root. But
// the vendored V8 headers reference each other by bare name from within that
// tree (e.g. v8.h -> cppgc/common.h -> "v8config.h", Chromium-style, expecting
// the include/ dir itself on the search path) -- SPM only exposes the Headers
// parent, not the nested include/ dir, so those bare includes fall through to
// whatever OTHER "-I .../include"-shaped path happens to be on the compiler's
// search list. That used to be the NativeScript runtime framework's own
// (still V8 10.3) Headers/include, which "won" the include-guard race against
// the real nativescript-v8/Headers/include/v8config.h and silently fed stale
// V8 10.3 macros into freshly-vendored V8 14.9 headers -- so pointing this at
// the vendored tree instead is required, not optional.
// Delivered as -I compiler flags rather than HEADER_SEARCH_PATHS because the
// NativeScript CLI pod-xcconfig merge is key-exclusive: a plugin-level
// HEADER_SEARCH_PATHS would silently drop the CocoaPods header paths. A
// Podfile post_install can't carry it either — CocoaPods saves the user
// project before post_install runs, so those edits never persist — which is
// why this package ships no Podfile at all: everything native arrives via the
// NativeScriptV8 SwiftPM package in nativescript.config.ts plus the vendored
// CanvasNative.xcframework.
// Two roots because the shim lives in a different place depending on who is
// building. $(SRCROOT) is always <app>/platforms/<platform>:
//   * installed plugin  -> <app>/node_modules/@nativescript/canvas/platforms/ios/
//                          NativeScriptV8/Headers/include (packaged by
//                          project.json, referenced by nativescript.config.ts)
//   * this monorepo     -> <repo>/nativescript-v8/Headers/include (the demo's
//                          own nativescript.config.ts points SwiftPM there, and
//                          the shim dir is only materialised into dist/)
// clang silently ignores a -I that doesn't exist, so shipping both is safe and
// exactly one resolves in any given build. NOTE: the npm path assumes canvas
// resolves to <app>/node_modules — the same assumption the SPM `path:` in
// nativescript.config.ts already makes, so a hoisted install breaks both
// together, not just this.
CANVAS_NS_V8_HEADERS_NPM = $(SRCROOT)/../../node_modules/@nativescript/canvas/platforms/ios/NativeScriptV8/Headers/include
CANVAS_NS_V8_HEADERS_MONOREPO = $(SRCROOT)/../../../../nativescript-v8/Headers/include
CANVAS_NS_V8_HEADER_FLAGS = -I"$(CANVAS_NS_V8_HEADERS_NPM)" -I"$(CANVAS_NS_V8_HEADERS_MONOREPO)"
OTHER_CFLAGS = $(inherited) $(CANVAS_NS_V8_HEADER_FLAGS)
OTHER_CPLUSPLUSFLAGS = $(inherited) $(CANVAS_NS_V8_HEADER_FLAGS)
